### Create a new Lingo - Minimal example
POST http://localhost:5000/api/lingos/
Content-Type: application/json

{
  "userId": "user-019c006a67fa7ae299ef23af44cb3454",
  "lingo": "serendipity",
  "lingoType": "Word",
  "definition": "The occurrence of events by chance in a happy or beneficial way",
  "translation": "یافتن چیزی خوب به طور تصادفی",
  "sourceLanguageId": "en-US",
  "targetLanguageId": "fa-IR"
}

### Create a new Lingo - Complete example with all optional fields
POST http://localhost:5000/api/lingos/
Content-Type: application/json

{
  "userId": "user-019c006a67fa7ae299ef23af44cb3454",
  "lingo": "break the ice",
  "lingoType": "Expression",
  "definition": "To initiate social interaction in a way that relaxes people and makes them feel comfortable",
  "translation": "یخ را شکستن، جو را گرم کردن",
  "sourceLanguageId": "en-US",
  "targetLanguageId": "fa-IR",
  "style": "Informal",
  "examples": [
    "He told a joke to break the ice at the beginning of the meeting.",
    "It's always hard to break the ice when you meet someone new.",
    "The host played a game to help everyone break the ice."
  ],
  "context": ["Workplace", "Social"],
  "tags": ["conversation", "social-skills", "idioms"],
  "learningGoal": "Active",
  "userNote": "Common expression used in networking events",
  "sourceMethod": "AI",
  "sourceAIModel": "gpt-4",
  "sourceAIModelVersion": "2024-01"
}

### Create a new Lingo - Technical word example
POST http://localhost:5000/api/lingos/
Content-Type: application/json

{
  "userId": "user-019c006a67fa7ae299ef23af44cb3454",
  "lingo": "algorithm",
  "lingoType": "Word",
  "definition": "A step-by-step procedure for solving a problem or accomplishing a task",
  "translation": "الگوریتم",
  "sourceLanguageId": "en-US",
  "targetLanguageId": "fa-IR",
  "style": "Academic",
  "examples": [
    "The algorithm processes data in linear time.",
    "We need to optimize this sorting algorithm."
  ],
  "context": ["Technical"],
  "tags": ["computer-science", "programming", "technical"],
  "learningGoal": "Active",
  "sourceMethod": "Manual"
}

###
# Reference for enum values:
#
# LingoType:
#   1 = Word
#   2 = Phrase
#   3 = Expression
#   4 = Idiom
#   5 = Collocation
#   6 = Slang
#
# WordStyle:
#   1 = Formal
#   2 = Informal
#   3 = Casual
#   4 = Slang
#   5 = Academic
#   6 = Professional
#
# Context:
#   1 = Workplace
#   2 = Academic
#   3 = Social
#   4 = Daily
#   5 = Travel
#   6 = Medical
#   7 = Legal
#   8 = Technical
#   9 = Business
#   10 = Entertainment
#   11 = Sports
#   12 = News
#   13 = Media
#   14 = Literature
#
# LearningGoal:
#   1 = Passive (just understand)
#   2 = Active (use in speech/writing)
#
# SourceMethod:
#   1 = Manual
#   2 = AI
