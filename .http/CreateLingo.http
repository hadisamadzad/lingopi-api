  ],
  "context": [8],
  "tags": ["computer-science", "programming", "technical"],
  "learningGoal": 2,
  "sourceMethod": 1
}

###
# Reference for enum values:
# 
# LingoType:
#   1 = Word
#   2 = Phrase
#   3 = Expression
#   4 = Idiom
#   5 = Collocation
#   6 = Slang
#
# WordStyle:
#   1 = Formal
#   2 = Informal
#   3 = Casual
#   4 = Slang
#   5 = Academic
#   6 = Professional
#
# Context:
#   1 = Workplace
#   2 = Academic
#   3 = Social
#   4 = Daily
#   5 = Travel
#   6 = Medical
#   7 = Legal
#   8 = Technical
#   9 = Business
#   10 = Entertainment
#   11 = Sports
#   12 = News
#   13 = Media
#   14 = Literature
#
# LearningGoal:
#   1 = Passive (just understand)
#   2 = Active (use in speech/writing)
#
# SourceMethod:
#   1 = Manual
#   2 = AI
