### Create a new Lingo - Minimal example
POST http://localhost:5000/api/lingos/
Content-Type: application/json

{
  "userId": "user-01j7x8qk9m2nf5g3h1j4w6p7t2",
  "lingo": "serendipity",
  "lingoType": 1,
  "definition": "The occurrence of events by chance in a happy or beneficial way",
  "translation": "یافتن چیزی خوب به طور تصادفی",
  "sourceLanguage": {
    "code": "en",
    "name": "English",
    "nativeName": "English"
  },
  "targetLanguage": {
    "code": "fa",
    "name": "Persian",
    "nativeName": "فارسی"
  }
}

### Create a new Lingo - Complete example with all optional fields
POST http://localhost:5000/api/lingos/
Content-Type: application/json

{
  "userId": "user-01j7x8qk9m2nf5g3h1j4w6p7t2",
  "lingo": "break the ice",
  "lingoType": 3,
  "definition": "To initiate social interaction in a way that relaxes people and makes them feel comfortable",
  "translation": "یخ را شکستن، جو را گرم کردن",
  "sourceLanguage": {
    "code": "en",
    "name": "English",
    "nativeName": "English"
  },
  "targetLanguage": {
    "code": "fa",
    "name": "Persian",
    "nativeName": "فارسی"
  },
  "style": 2,
  "examples": [
    "He told a joke to break the ice at the beginning of the meeting.",
    "It's always hard to break the ice when you meet someone new.",
    "The host played a game to help everyone break the ice."
  ],
  "context": [1, 3],
  "tags": ["conversation", "social-skills", "idioms"],
  "learningGoal": 2,
  "userNote": "Common expression used in networking events",
  "sourceMethod": 2,
  "sourceAIModel": "gpt-4",
  "sourceAIModelVersion": "2024-01"
}

### Create a new Lingo - Technical word example
POST http://localhost:5000/api/lingos/
Content-Type: application/json

{
  "userId": "user-01j7x8qk9m2nf5g3h1j4w6p7t2",
  "lingo": "algorithm",
  "lingoType": 1,
  "definition": "A step-by-step procedure for solving a problem or accomplishing a task",
  "translation": "الگوریتم",
  "sourceLanguage": {
    "code": "en",
    "name": "English",
    "nativeName": "English"
  },
  "targetLanguage": {
    "code": "fa",
    "name": "Persian",
    "nativeName": "فارسی"
  },
  "style": 5,
  "examples": [
    "The algorithm processes data in linear time.",
