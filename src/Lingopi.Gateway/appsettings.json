{
  "Urls": "http://0.0.0.0:5000",
  "JwtSecurityToken": {
    "Issuer": "{auth_jwt_issuer}",
    "Audience": "{auth_jwt_audience}",
    "SecretKey": "{auth_jwt_access_token_secret_key}"
  },
  "GoogleAuth": {
    "ClientId": "{google_auth_client_id}",
    "ClientSecret": "{google_auth_client_secret}",
    "SuccessRedirectUri": "{google_auth_success_redirect_uri}"
  },
  "IdentityService": {
    "BaseUrl": "http://lingopi-identity:5000"
  },
  "InternalAuthSecret": "{internal_auth_secret}",
  "AllowedOrigins": "{allowed_origins}",
  "Serilog": {
    "Using": ["Serilog.Sinks.Datadog.Logs"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "DatadogLogs",
        "Args": {
          "apiKey": "{datadog_api_key}",
          "source": "lingopi",
          "service": "lingopi-{env}-gateway",
          "host": "lingopi.gateway",
          "configuration": {
            "url": "intake.logs.datadoghq.com",
            "port": 10516,
            "useSSL": true,
            "useTCP": true
          }
        }
      }
    ]
  }
}
